local player = game.Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

-- REMOVE ANTIGO
if pg:FindFirstChild("BlackReignHub") then
    pg.BlackReignHub:Destroy()
end

-- HUMANOID
local function getHumanoid()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("Humanoid")
end

-- GUI
local sg = Instance.new("ScreenGui", pg)
sg.Name = "BlackReignHub"

-- BOTÃO FLUTUANTE
local toggle = Instance.new("TextButton", sg)
toggle.Size = UDim2.new(0,50,0,50)
toggle.Position = UDim2.new(0,20,0.5,0)
toggle.Text = "⚡"
toggle.BackgroundColor3 = Color3.fromRGB(30,30,30)
toggle.TextColor3 = Color3.new(1,1,1)
toggle.Active = true
toggle.Draggable = true
Instance.new("UICorner", toggle)

-- MAIN
local main = Instance.new("Frame", sg)
main.Size = UDim2.new(0,350,0,260)
main.Position = UDim2.new(0.5,-175,0.5,-130)
main.BackgroundColor3 = Color3.fromRGB(18,18,22)
main.Visible = true
main.Active = true
main.Draggable = true
Instance.new("UICorner", main)

-- RGB
local stroke = Instance.new("UIStroke", main)
stroke.Thickness = 3

task.spawn(function()
    while true do
        for i=0,1,0.01 do
            stroke.Color = Color3.fromHSV(i,1,1)
            task.wait()
        end
    end
end)

-- TÍTULO
local title = Instance.new("TextLabel", main)
title.Size = UDim2.new(1,0,0,40)
title.Text = "𝙱𝚕𝚊𝚌𝚔_𝚛𝚎𝚒𝚐𝚗"
title.BackgroundTransparency = 1
title.TextColor3 = Color3.new(1,1,1)
title.Font = Enum.Font.GothamBold
title.TextSize = 16

-- FECHAR
local close = Instance.new("TextButton", main)
close.Size = UDim2.new(0,30,0,30)
close.Position = UDim2.new(1,-35,0,5)
close.Text = "X"
close.BackgroundColor3 = Color3.fromRGB(40,40,45)
close.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", close)

close.MouseButton1Click:Connect(function()
    main.Visible = false
end)

toggle.MouseButton1Click:Connect(function()
    main.Visible = not main.Visible
end)

-- INPUT SPEED
local input = Instance.new("TextBox", main)
input.Size = UDim2.new(0.8,0,0,40)
input.Position = UDim2.new(0.1,0,0.25,0)
input.PlaceholderText = "Velocidade..."
input.BackgroundColor3 = Color3.fromRGB(35,35,40)
input.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", input)

-- BOTÃO SPEED
local speedBtn = Instance.new("TextButton", main)
speedBtn.Size = UDim2.new(0.8,0,0,40)
speedBtn.Position = UDim2.new(0.1,0,0.45,0)
speedBtn.Text = "Aplicar Speed"
speedBtn.BackgroundColor3 = Color3.fromRGB(46,204,113)
speedBtn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", speedBtn)

speedBtn.MouseButton1Click:Connect(function()
    local num = tonumber(input.Text)
    if num then
        getHumanoid().WalkSpeed = num
    end
end)

-- PULO INFINITO
local infJump = false

local jumpBtn = Instance.new("TextButton", main)
jumpBtn.Size = UDim2.new(0.8,0,0,40)
jumpBtn.Position = UDim2.new(0.1,0,0.65,0)
jumpBtn.Text = "Pulo Infinito OFF"
jumpBtn.BackgroundColor3 = Color3.fromRGB(52,152,219)
jumpBtn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", jumpBtn)

game:GetService("UserInputService").JumpRequest:Connect(function()
    if infJump then
        getHumanoid():ChangeState("Jumping")
    end
end)

jumpBtn.MouseButton1Click:Connect(function()
    infJump = not infJump
    jumpBtn.Text = infJump and "Pulo Infinito ON" or "OFF"
end)

-- FLY AVANÇADO
local flying = false
local flySpeed = 60
local bv

local flyBtn = Instance.new("TextButton", main)
flyBtn.Size = UDim2.new(0.8,0,0,40)
flyBtn.Position = UDim2.new(0.1,0,0.85,0)
flyBtn.Text = "Fly OFF"
flyBtn.BackgroundColor3 = Color3.fromRGB(155,89,182)
flyBtn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", flyBtn)

flyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    flyBtn.Text = flying and "Fly ON" or "Fly OFF"

    local char = player.Character
    local hrp = char:WaitForChild("HumanoidRootPart")

    if flying then
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e5,1e5,1e5)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp

        game:GetService("RunService").RenderStepped:Connect(function()
            if flying and bv then
                local cam = workspace.CurrentCamera
                bv.Velocity = cam.CFrame.LookVector * flySpeed
            end
        end)
    else
        if bv then
            bv:Destroy()
            bv = nil
        end
    end
end)
